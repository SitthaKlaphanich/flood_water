# Bangkok Flood Monitor Configuration

# Server Port
PORT=5001
NODE_ENV=development

# Real-time Data Refresh Interval (milliseconds, default 30s = 30000)
# Respects BMA server capacity by polling through the backend aggregator
DATA_REFRESH_INTERVAL=30000

# Cache TTL (seconds) to prevent duplicate requests to upstream government servers
CACHE_TTL_SECONDS=30

# Database Configuration (SQLite default, easily upgradable to PostgreSQL)
DB_TYPE=sqlite
DB_PATH=./data/bangkok_flood.sqlite

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5001,http://localhost:3000
RATE_LIMIT_MAX=300
